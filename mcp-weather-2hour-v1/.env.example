# Hosted Colab: set OPENAI_API_KEY and SERPAPI_KEY in Secrets instead of this file.
# Local runtime: copy this file to .env and fill the keys you want to use.

MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional local-computer backend (not used by the hosted Colab class).
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=

# Separate credential for live weather (both runtimes).
SERPAPI_KEY=
SERPAPI_TIMEOUT_SECONDS=60
SERPAPI_RETRIES=2
HTTP_TIMEOUT_SECONDS=60
